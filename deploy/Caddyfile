{$DOMAIN:localhost:8000} {
	encode zstd gzip

	# /metrics — служебный эндпоинт для Prometheus
	handle /metrics {
		respond "not found" 404
	}

	# Маршрутизация загрузки медиа в mediaworker
	handle /api/media/* {
		reverse_proxy mediaworker:8001
	}

	# Маршрутизация REST API в Billing Engine
	handle /api/* {
		reverse_proxy billing:8000
	}

	# Маршрутизация WebSocket в Billing Engine
	handle /ws/* {
		reverse_proxy billing:8000
	}

	# Раздача SPA интерфейса Admin UI
	handle {
		reverse_proxy adminui:80
	}
}

{$MEDIA_DOMAIN:localhost:8001} {
	encode zstd gzip

	# /metrics — служебный эндпоинт для Prometheus
	handle /metrics {
		respond "not found" 404
	}

	handle {
		reverse_proxy mediaworker:8001
	}
}
